# Copy to .env for local development (.env is git-ignored; never commit it).
# On Render, set these under Service -> Environment instead.
# Every variable is optional; the defaults are shown.

# ---- Answer generation -------------------------------------------------
# ollama : local Ollama (default, for your own machine)
# openai : any OpenAI-compatible chat API (OpenAI, Groq, OpenRouter, ...) - use this on Render
# none   : no LLM; /ask answers from the knowledge base only
LLM_PROVIDER=ollama

# Ollama (LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# OpenAI-compatible API (LLM_PROVIDER=openai)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=
# LLM_API_KEY=            # secret - set it only in .env or the Render dashboard

LLM_TIMEOUT=120
LLM_MAX_TOKENS=160
LLM_TEMPERATURE=0.2

# When the LLM is unavailable, answer with the closest knowledge-base entry.
KB_FALLBACK=true

# ---- Knowledge base (RAG) ------------------------------------------------
# Relative paths are resolved from the project root.
INDEX_PATH=models/combined.index
METADATA_PATH=models/combined_metadata.pkl
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Where the embedding model is downloaded/cached (also used as HF_HOME).
MODEL_CACHE_DIR=.cache
FAISS_TOP_K=3
FINAL_CONTEXTS=2
MIN_FAISS_SCORE=0.25
# Load the knowledge base in a background thread right after startup.
WARMUP_ON_STARTUP=true
# After a load failure, wait this long before trying again.
RAG_RETRY_SECONDS=60

# ---- HTTP ----------------------------------------------------------------
# Comma-separated list. Empty = allow chrome-extension:// origins and localhost.
# CORS_ALLOW_ORIGINS=chrome-extension://<your-extension-id>
MAX_QUESTION_CHARS=4000
LOG_LEVEL=INFO
